 style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_d4" target="l_d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_b5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_d5" target="l_d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_b6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_d6" target="l_d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_f0" value="FAULT detected (see sources below)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="l_f1" value="Classify severity; log incident (tc_journal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="198" width="300" height="64" as="geometry"/></mxCell><mxCell id="l_f2" value="Recoverable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="300" height="100" as="geometry"/></mxCell><mxCell id="l_f3" value="State = DEGRADED: block new orders, keep protective stops, keep exits live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="412" width="300" height="76" as="geometry"/></mxCell><mxCell id="l_f4" value="Reconnect with backoff, resubscribe, backfill missed bars, reqOpenOrders resync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="522" width="300" height="76" as="geometry"/></mxCell><mxCell id="l_f5" value="Recovered and&lt;br&gt;reconciled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="300" height="100" as="geometry"/></mxCell><mxCell id="l_f6" value="Resume trading (state = RUNNING)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="755" width="300" height="50" as="geometry"/></mxCell><mxCell id="l_f7" value="HALTED: kill switch ON, cancel entries (keep stops), alert operator; manual acknowledge required to restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="512" width="260" height="96" as="geometry"/></mxCell><mxCell id="l_c0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f0" target="l_f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f1" target="l_f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_c2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f2" target="l_f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f3" target="l_f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f4" target="l_f5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_c5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f5" target="l_f6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_cn2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f2" target="l_f7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_cn5" value="No (timeout)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_f5" target="l_f7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_fs" value="&lt;b&gt;Fault sources and default action&lt;/b&gt;&lt;br&gt;IBKR errors 1100 / 1101 / 1102 (connectivity lost / restored): DEGRADED, reconnect + resync&lt;br&gt;Feed stale &amp;gt; N seconds during session: DEGRADED, backfill&lt;br&gt;Order reject / timeout / duplicate ID: exception handler; escalate after N repeats&lt;br&gt;Position or cash mismatch at reconciliation: HALT affected symbols&lt;br&gt;Module returns TC_ERR_INTERNAL or misses heartbeat: module FAILED, HALTED&lt;br&gt;Risk breach (daily loss, max drawdown, exposure): kill switch ON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1100" y="870" width="640" height="190" as="geometry"/></mxCell><mxCell id="l_st" value="&lt;b&gt;Engine states:&amp;nbsp;&amp;nbsp;INIT &amp;gt; CONNECTING &amp;gt; SYNCING &amp;gt; RUNNING &amp;lt;&amp;gt; DEGRADED &amp;gt; HALTED &amp;gt; STOPPING &amp;gt; STOPPED&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="1500" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 - Headers &amp; ABI Reference" id="r_dg"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r_title" value="&lt;b&gt;Header, ABI and project-layout reference (for implementing the DLLs)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1500" height="30" as="geometry"/></mxCell><mxCell id="r_fold" value="&lt;b&gt;Project layout&lt;/b&gt;&lt;br&gt;tc-trader/&lt;br&gt;&amp;nbsp;&amp;nbsp;CMakeLists.txt&lt;br&gt;&amp;nbsp;&amp;nbsp;include/tc/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(shared, header-only)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tc_abi.h&amp;nbsp;&amp;nbsp;tc_types.h&amp;nbsp;&amp;nbsp;tc_module.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tc_ringbuffer.hpp&amp;nbsp;&amp;nbsp;tc_time.hpp&amp;nbsp;&amp;nbsp;tc_log.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;gateway/tc_gateway.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;marketdata/tc_marketdata.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;indicators/tc_indicators.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;indicators/tc_indicators_core.hpp&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;strategy/tc_strategy.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;risk/tc_risk.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;execution/tc_execution.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;portfolio/tc_portfolio.h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;journal/tc_journal.h&lt;br&gt;&amp;nbsp;&amp;nbsp;modules/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;gateway_ibkr/&amp;nbsp;&amp;nbsp;(links IBKR TWS API C++ client)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;gateway_sim/&amp;nbsp;&amp;nbsp; (backtest / replay, same ABI)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;marketdata/ indicators/ strategy/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;risk/ execution/ portfolio/ journal/&lt;br&gt;&amp;nbsp;&amp;nbsp;engine/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(tc_engine.exe: loader, wiring, control API)&lt;br&gt;&amp;nbsp;&amp;nbsp;config/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(engine.json, rules.json, risk.json)&lt;br&gt;&amp;nbsp;&amp;nbsp;tests/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (per-module unit tests + replay harness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="560" height="440" as="geometry"/></mxCell><mxCell id="r_abi" value="&lt;b&gt;tc_abi.h&lt;/b&gt;&lt;br&gt;#define TC_ABI_VERSION 0x00010000&amp;nbsp;&amp;nbsp; /* major.minor */&lt;br&gt;#ifdef _WIN32&lt;br&gt;&amp;nbsp;&amp;nbsp;#define TC_API extern &quot;C&quot; __declspec(dllexport) __cdecl&lt;br&gt;#endif&lt;br&gt;typedef struct TcHandle_* TcHandle;&amp;nbsp;&amp;nbsp; /* opaque */&lt;br&gt;typedef enum {&lt;br&gt;&amp;nbsp;&amp;nbsp;TC_OK = 0, TC_ERR_INVALID_ARG, TC_ERR_ABI_MISMATCH,&lt;br&gt;&amp;nbsp;&amp;nbsp;TC_ERR_NOT_CONNECTED, TC_ERR_QUEUE_FULL,&lt;br&gt;&amp;nbsp;&amp;nbsp;TC_ERR_RISK_REJECT, TC_ERR_INTERNAL&lt;br&gt;} TcStatus;&lt;br&gt;typedef int64_t TcPrice;&amp;nbsp;&amp;nbsp; /* fixed-point, price * 1e4 */" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="560" height="260" as="geometry"/></mxCell><mxCell id="r_mod" value="&lt;b&gt;tc_module.h&lt;/b&gt;&lt;br&gt;typedef struct TcModuleVTable {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size, abi_version;&lt;br&gt;&amp;nbsp;&amp;nbsp;const char* name;&lt;br&gt;&amp;nbsp;&amp;nbsp;TcStatus (*create)(const TcModuleConfig*, TcHandle*);&lt;br&gt;&amp;nbsp;&amp;nbsp;TcStatus (*start)(TcHandle);&lt;br&gt;&amp;nbsp;&amp;nbsp;TcStatus (*stop)(TcHandle);&lt;br&gt;&amp;nbsp;&amp;nbsp;void&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (*destroy)(TcHandle);&lt;br&gt;&amp;nbsp;&amp;nbsp;TcStatus (*get_status)(TcHandle, TcModuleStatus*);&lt;br&gt;&amp;nbsp;&amp;nbsp;void*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(*get_interface)(TcHandle, const char* name);&lt;br&gt;} TcModuleVTable;&lt;br&gt;&lt;br&gt;/* the ONLY mandatory export of every DLL */&lt;br&gt;TC_API const TcModuleVTable* tc_get_module_vtable(void);&lt;br&gt;&lt;br&gt;/* get_interface(&quot;ITcRisk&quot;) returns a versioned table&lt;br&gt;&amp;nbsp;&amp;nbsp; of function pointers; engine caches it once. */" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="560" height="330" as="geometry"/></mxCell><mxCell id="r_typ" value="&lt;b&gt;tc_types.h&amp;nbsp;&amp;nbsp;(POD only, fixed-width, versioned)&lt;/b&gt;&lt;br&gt;typedef struct {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size; uint16_t version, timeframe;&lt;br&gt;&amp;nbsp;&amp;nbsp;int32_t symbol_id; int64_t ts_ns;&lt;br&gt;&amp;nbsp;&amp;nbsp;TcPrice open, high, low, close; int64_t volume;&lt;br&gt;} TcBar;&lt;br&gt;&lt;br&gt;typedef struct {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size; uint16_t version; int32_t symbol_id;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64_t ts_ns; TcPrice bid, ask, last;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64_t bid_sz, ask_sz, last_sz;&lt;br&gt;} TcTick;&lt;br&gt;&lt;br&gt;typedef struct {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size; uint16_t version; int32_t symbol_id;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64_t ts_ns; uint32_t valid_mask;&lt;br&gt;&amp;nbsp;&amp;nbsp;double sma_fast, sma_slow, ema, rsi, macd, macd_sig,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; atr, bb_up, bb_mid, bb_lo, adx;&lt;br&gt;} TcIndicatorSnapshot;&lt;br&gt;&lt;br&gt;typedef struct {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size; uint16_t version; int32_t symbol_id;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64_t ts_ns; int8_t side;&amp;nbsp;&amp;nbsp; /* BUY / SELL / FLAT */&lt;br&gt;&amp;nbsp;&amp;nbsp;double strength; TcPrice stop, target; uint32_t rule_id;&lt;br&gt;} TcSignal;&lt;br&gt;&lt;br&gt;typedef struct {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size; uint16_t version; uint64_t intent_id;&lt;br&gt;&amp;nbsp;&amp;nbsp;int32_t symbol_id; int8_t side; int64_t qty;&lt;br&gt;&amp;nbsp;&amp;nbsp;uint8_t order_type, tif; TcPrice limit_px, stop_px, target_px;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64_t ts_ns;&lt;br&gt;} TcOrderIntent;&lt;br&gt;&lt;br&gt;typedef struct {&lt;br&gt;&amp;nbsp;&amp;nbsp;uint32_t struct_size; uint16_t version;&lt;br&gt;&amp;nbsp;&amp;nbsp;uint64_t client_order_id; int64_t broker_order_id;&lt;br&gt;&amp;nbsp;&amp;nbsp;uint8_t status;&amp;nbsp;&amp;nbsp; /* NEW SENT ACK PARTIAL FILLED CANCELLED REJECTED */&lt;br&gt;&amp;nbsp;&amp;nbsp;int64_t filled_qty; TcPrice avg_px; double commission;&lt;br&gt;&amp;nbsp;&amp;nbsp;int32_t err_code; int64_t ts_ns;&lt;br&gt;} TcOrderEvent;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="50" width="620" height="780" as="geometry"/></mxCell><mxCell id="r_rules" value="&lt;b&gt;Implementation rules for every module&lt;/b&gt;&lt;br&gt;1. Public header is C-compatible (compiles as C and C++).&lt;br&gt;2. Never pass std::string, std::vector, exceptions or&lt;br&gt;&amp;nbsp;&amp;nbsp; virtual classes across a DLL boundary.&lt;br&gt;3. Caller-allocated output buffers (ptr + capacity).&lt;br&gt;4. Callbacks (sinks) = C function pointer + void* user.&lt;br&gt;5. Sinks must be non-blocking; they push into a ring.&lt;br&gt;6. Hot-path calls must not allocate or take a lock.&lt;br&gt;7. Never call back into another module from a sink;&lt;br&gt;&amp;nbsp;&amp;nbsp; let the engine route (avoids re-entrancy).&lt;br&gt;8. All time in int64 nanoseconds (UTC); prices fixed-point.&lt;br&gt;9. Build every DLL with the same runtime settings&lt;br&gt;&amp;nbsp;&amp;nbsp; (/MD) but do not rely on it (C ABI makes it safe).&lt;br&gt;10. Unit-test each DLL alone via a mock engine + the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;replay harness (tc_gateway_sim.dll)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="560" height="380" as="geometry"/></mxCell><mxCell id="r_bld" value="&lt;b&gt;Suggested build order (each step is testable alone)&lt;/b&gt;&lt;br&gt;1. tc_abi.h / tc_types.h / tc_module.h / tc_ringbuffer.hpp&lt;br&gt;2. tc_journal.dll&amp;nbsp;&amp;nbsp; 3. tc_portfolio.dll&lt;br&gt;4. tc_indicators (core header + DLL)&lt;br&gt;5. tc_strategy.dll&amp;nbsp;&amp;nbsp;6. tc_risk.dll&lt;br&gt;7. tc_marketdata.dll&amp;nbsp;&amp;nbsp;8. tc_gateway_sim.dll (replay)&lt;br&gt;9. tc_execution.dll&amp;nbsp;&amp;nbsp;10. tc_gateway_ibkr.dll (paper account)&lt;br&gt;11. tc_engine.exe wiring + control API&lt;br&gt;12. Backtest &amp;gt; paper trading &amp;gt; small live size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="690" width="560" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>