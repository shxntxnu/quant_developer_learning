-up, graceful shutdown and fault handling&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1500" height="30" as="geometry"/></mxCell><mxCell id="l_h40" value="&lt;b&gt;1&amp;nbsp;&amp;nbsp;START-UP SEQUENCE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="300" height="24" as="geometry"/></mxCell><mxCell id="l_h640" value="&lt;b&gt;2&amp;nbsp;&amp;nbsp;GRACEFUL SHUTDOWN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="45" width="300" height="24" as="geometry"/></mxCell><mxCell id="l_h1100" value="&lt;b&gt;3&amp;nbsp;&amp;nbsp;FAULT HANDLING&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="45" width="300" height="24" as="geometry"/></mxCell><mxCell id="l_s0" value="START: tc_engine.exe launched" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="l_s1" value="Load &amp;amp; validate config (JSON): symbols, rules, risk limits, IBKR host / port / clientId, DLL paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="300" height="76" as="geometry"/></mxCell><mxCell id="l_s2" value="Config valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="300" height="100" as="geometry"/></mxCell><mxCell id="l_s3" value="Init tc_journal.dll first, so every later step is logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="300" height="64" as="geometry"/></mxCell><mxCell id="l_s4" value="LoadLibrary each DLL &amp;gt; GetProcAddress(tc_get_module_vtable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="300" height="76" as="geometry"/></mxCell><mxCell id="l_s5" value="All DLLs loaded and&lt;br&gt;ABI version compatible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="100" as="geometry"/></mxCell><mxCell id="l_s6" value="Create modules in dependency order: portfolio &amp;gt; risk &amp;gt; indicators &amp;gt; strategy &amp;gt; execution &amp;gt; marketdata &amp;gt; gateway; wire rings and sinks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="300" height="90" as="geometry"/></mxCell><mxCell id="l_s7" value="Connect to IB Gateway / TWS (EClient::eConnect) with retry + exponential backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="300" height="76" as="geometry"/></mxCell><mxCell id="l_s8" value="Connected and next valid&lt;br&gt;order ID received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="300" h