<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="1 - DLL Architecture" id="a_dg"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a_title" value="&lt;b&gt;Rule-Based Trading System&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;Modular C++ DLL Architecture (C ABI boundaries, Interactive Brokers execution)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1480" height="40" as="geometry"/></mxCell><mxCell id="a_l1" value="&lt;b&gt;LAYER 1&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;Host application: tc_engine.exe (mediator: the only code that knows every module)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#1a1a1a;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1480" height="200" as="geometry"/></mxCell><mxCell id="a_h0" value="&lt;b&gt;Engine Core / Orchestrator&lt;/b&gt;&lt;br&gt;Lifecycle state machine&lt;br&gt;(INIT &amp;gt; CONNECTING &amp;gt; SYNCING &amp;gt; RUNNING &amp;gt; DEGRADED &amp;gt; HALTED &amp;gt; STOPPING)&lt;br&gt;Main event loop, thread creation (T0-T5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_h1" value="&lt;b&gt;Plugin Loader&lt;/b&gt;&lt;br&gt;LoadLibrary / GetProcAddress&lt;br&gt;resolves tc_get_module_vtable()&lt;br&gt;ABI version handshake, dependency-ordered init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_h2" value="&lt;b&gt;Pipeline Wiring&lt;/b&gt;&lt;br&gt;SPSC ring buffers between threads&lt;br&gt;function-table sinks between modules&lt;br&gt;T1&amp;gt;T2, T2&amp;gt;T3, T1&amp;gt;T3, any&amp;gt;T4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_h3" value="&lt;b&gt;Config Manager&lt;/b&gt;&lt;br&gt;engine.json / rules.json / risk.json&lt;br&gt;schema validation&lt;br&gt;hot-reload of rules (not of ABI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_h4" value="&lt;b&gt;Health &amp;amp; Watchdog&lt;/b&gt;&lt;br&gt;Heartbeats, feed-staleness timer&lt;br&gt;module status polling&lt;br&gt;kill-switch relay, DEGRADED/HALTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_h5" value="&lt;b&gt;Control &amp;amp; Telemetry API&lt;/b&gt;&lt;br&gt;REST / WebSocket (read-mostly)&lt;br&gt;for external dashboard / CLI&lt;br&gt;manual halt / resume commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_l2" value="&lt;b&gt;LAYER 2&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;Plugin DLLs (each boundary = extern &quot;C&quot; ABI, opaque handles, POD structs, versioned function tables)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#1a1a1a;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1480" height="670" as="geometry"/></mxCell><mxCell id="a_c0" value="&lt;b&gt;tc_gateway_ibkr.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: include/tc/gateway/tc_gateway.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcGateway)&lt;/b&gt;&lt;br&gt;connect / disconnect / is_connected&lt;br&gt;subscribe_ticks / subscribe_bars&lt;br&gt;request_history (backfill, warm-up)&lt;br&gt;place_order / cancel_order / req_open_orders&lt;br&gt;set_event_sink &amp;gt; SPSC ring (raw events)&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;IbWrapperImpl (EWrapper), EReader thread&lt;br&gt;ContractMapper, PacingLimiter, ReconnectPolicy&lt;br&gt;&lt;i&gt;Swap-in: tc_gateway_sim.dll (backtest / replay), same ABI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c1" value="&lt;b&gt;tc_marketdata.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: tc_marketdata.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcMarketData)&lt;/b&gt;&lt;br&gt;on_raw_event(TcRawEvent*)&lt;br&gt;set_bar_sink(fn, user)&lt;br&gt;get_feed_status(symbol_id)&lt;br&gt;reset_symbol(symbol_id)&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;TickNormalizer&lt;br&gt;DataValidator (stale / gap / dup / outlier)&lt;br&gt;BarAggregator, SessionCalendar&lt;br&gt;FeedHealthMonitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="425" y="400" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c2" value="&lt;b&gt;tc_indicators.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;headers: tc_indicators.h + tc_indicators_core.hpp&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcIndicators)&lt;/b&gt;&lt;br&gt;create_set(spec) / destroy_set&lt;br&gt;update_bar(TcBar*)&lt;br&gt;get_snapshot(symbol_id, TcIndicatorSnapshot*)&lt;br&gt;reset / warmup_bars_required&lt;br&gt;&lt;b&gt;Internal C++ (header-only core)&lt;/b&gt;&lt;br&gt;SMA, EMA, RSI, MACD, ATR, Bollinger, ADX&lt;br&gt;O(1) incremental updates, fixed ring state&lt;br&gt;&lt;i&gt;Core inlined into tc_strategy.dll for zero-call hot path&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="790" y="400" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c3" value="&lt;b&gt;tc_strategy.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: tc_strategy.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcStrategy)&lt;/b&gt;&lt;br&gt;configure(rules_json)&lt;br&gt;on_snapshot(TcIndicatorSnapshot*, TcPositionView*)&lt;br&gt;drain_signals(TcSignal* out, n)&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;RegimeClassifier&lt;br&gt;EntryRules, ExitRules&lt;br&gt;SignalCombiner&lt;br&gt;RuleSet (data-driven, hot-reloadable)&lt;br&gt;&lt;i&gt;Pure function (snapshot, position) &amp;gt; signals. No I/O, no broker calls&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1155" y="400" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c4" value="&lt;b&gt;tc_risk.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: tc_risk.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcRisk)&lt;/b&gt;&lt;br&gt;evaluate_signal(TcSignal*, TcOrderIntent* out)&lt;br&gt;update_state(TcAccountView*)&lt;br&gt;set_kill_switch / get_kill_switch&lt;br&gt;get_limits / set_limits&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;PositionSizer, PreTradeChecks&lt;br&gt;ExposureTracker, DrawdownMonitor&lt;br&gt;KillSwitch (std::atomic flag, readable lock-free)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c5" value="&lt;b&gt;tc_execution.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: tc_execution.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcExecution)&lt;/b&gt;&lt;br&gt;submit_intent(TcOrderIntent*)&lt;br&gt;on_gateway_event(TcOrderEvent*)&lt;br&gt;cancel_all / cancel_order&lt;br&gt;get_order_state(client_order_id)&lt;br&gt;set_fill_sink(fn, user)&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;OrderManager, OrderStateMachine, Throttle&lt;br&gt;BracketBuilder, FillHandler, TimeoutWatchdog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="425" y="700" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c6" value="&lt;b&gt;tc_portfolio.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: tc_portfolio.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcPortfolio)&lt;/b&gt;&lt;br&gt;apply_fill(TcFill*)&lt;br&gt;get_position(symbol_id) / get_account&lt;br&gt;reconcile(broker_positions[], n)&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;PositionBook&lt;br&gt;PnLEngine (realised / unrealised)&lt;br&gt;CashLedger&lt;br&gt;Reconciler (vs IBKR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="790" y="700" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_c7" value="&lt;b&gt;tc_journal.dll&lt;/b&gt;&lt;br&gt;&lt;i&gt;header: tc_journal.h&lt;/i&gt;&lt;br&gt;&lt;b&gt;C ABI table (ITcJournal)&lt;/b&gt;&lt;br&gt;log(level, code, TcEvent*)&lt;br&gt;snapshot(state_blob) / flush&lt;br&gt;set_sink(file / SQLite / Parquet)&lt;br&gt;&lt;b&gt;Internal C++&lt;/b&gt;&lt;br&gt;Lock-free MPSC queue&lt;br&gt;AsyncWriter thread (T4)&lt;br&gt;RotatingFileSink&lt;br&gt;SQLite / Parquet adapters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1155" y="700" width="345" height="280" as="geometry"/></mxCell><mxCell id="a_l3" value="&lt;b&gt;LAYER 3&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;Shared headers (header-only, no binary; included by every module and the engine)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#1a1a1a;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1480" height="210" as="geometry"/></mxCell><mxCell id="a_s0" value="&lt;b&gt;tc_abi.h&lt;/b&gt;&lt;br&gt;TC_API export macro&lt;br&gt;TC_ABI_VERSION&lt;br&gt;TcStatus error codes&lt;br&gt;Opaque handle typedefs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_s1" value="&lt;b&gt;tc_types.h&lt;/b&gt;&lt;br&gt;POD structs: TcTick, TcBar,&lt;br&gt;TcIndicatorSnapshot, TcSignal,&lt;br&gt;TcOrderIntent, TcOrderEvent, TcFill,&lt;br&gt;TcPosition (all versioned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="300" y="1100" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_s2" value="&lt;b&gt;tc_module.h&lt;/b&gt;&lt;br&gt;TcModuleVTable&lt;br&gt;(create / start / stop / destroy /&lt;br&gt;get_status / get_interface)&lt;br&gt;tc_get_module_vtable()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="540" y="1100" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_s3" value="&lt;b&gt;tc_ringbuffer.hpp&lt;/b&gt;&lt;br&gt;SPSC + MPSC lock-free queues&lt;br&gt;alignas(64) indices&lt;br&gt;fixed capacity, no allocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="780" y="1100" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_s4" value="&lt;b&gt;tc_time.hpp&lt;/b&gt;&lt;br&gt;ns clock, session calendar&lt;br&gt;helpers, timezone utils" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1020" y="1100" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_s5" value="&lt;b&gt;tc_log.h&lt;/b&gt;&lt;br&gt;Log-sink function pointer&lt;br&gt;levels, event codes&lt;br&gt;(routes to tc_journal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1260" y="1100" width="220" height="130" as="geometry"/></mxCell><mxCell id="a_e12" value="LoadLibrary &gt; tc_get_module_vtable() &gt; create / start / stop / destroy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_l1" target="a_l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e23" value="#include (compile-time only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_l2" target="a_l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_t2" value="&lt;b&gt;RUNTIME DATA PATH &amp;amp; THREAD MODEL&amp;nbsp;&amp;nbsp;(T1 = IBKR EReader, T2 = pipeline, T3 = order thread, T4 = journal writer, T5 = timer)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="1480" height="30" as="geometry"/></mxCell><mxCell id="a_d0" value="Gateway (in)&lt;br&gt;callbacks, T1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d1" value="Market Data&lt;br&gt;normalise, bar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d2" value="Indicators&lt;br&gt;incremental" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d3" value="Strategy&lt;br&gt;regime + rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="630" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d4" value="Risk&lt;br&gt;size + checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d5" value="Execution&lt;br&gt;order FSM, T3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d6" value="Gateway (out)&lt;br&gt;placeOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="1330" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d7" value="Portfolio&lt;br&gt;fills, PnL, recon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1450" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_d8" value="Journal (T4)&lt;br&gt;audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="1450" width="150" height="60" as="geometry"/></mxCell><mxCell id="a_dc0" value="ring T1&gt;T2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d0" target="a_d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dc1" value="bar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d1" target="a_d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dc2" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d2" target="a_d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dc3" value="signal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d3" target="a_d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dc4" value="intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d4" target="a_d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dc5" value="placeOrder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d5" target="a_d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dcb" value="status / fills (ring T1&gt;T3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="a_d6" target="a_d5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="1305"/><mxPoint x="1055" y="1305"/></Array></mxGeometry></mxCell><mxCell id="a_dcp" value="FILLED events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d5" target="a_d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dcr" value="equity / DD / exposure feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="a_d7" target="a_d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_dcj" value="log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="a_d7" target="a_d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_n1" value="T1 &amp;gt; T2: SPSC ring (raw events). T2 runs Market Data &amp;gt; Indicators &amp;gt; Strategy &amp;gt; Risk as direct function-table calls (no locks, queues or copies)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="1540" width="470" height="60" as="geometry"/></mxCell><mxCell id="a_n2" value="T2 &amp;gt; T3: SPSC ring (TcOrderIntent).&amp;nbsp;&amp;nbsp;T1 &amp;gt; T3: SPSC ring (TcOrderEvent).&amp;nbsp;&amp;nbsp;Any thread &amp;gt; T4: lock-free MPSC journal queue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="550" y="1540" width="470" height="60" as="geometry"/></mxCell><mxCell id="a_n3" value="T5 timer: reconciliation vs IBKR, heartbeats, end-of-day snapshot. T0 (main): control API, watchdog, lifecycle." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="1540" width="470" height="60" as="geometry"/></mxCell><mxCell id="a_dd" value="&lt;b&gt;DESIGN DECISIONS&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;stability AND performance&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="1480" height="30" as="geometry"/></mxCell><mxCell id="a_ds" value="&lt;b&gt;Stability&lt;/b&gt;&lt;br&gt;1. One mandatory export per DLL: tc_get_module_vtable(). Everything else is reached through versioned function tables (no name mangling, no per-function GetProcAddress).&lt;br&gt;2. extern &quot;C&quot; + opaque handles + POD structs only. No STL, exceptions, RTTI or virtual classes cross a boundary.&lt;br&gt;3. Every struct starts with struct_size + version; new fields are append-only, so old and new DLLs interoperate.&lt;br&gt;4. Each DLL allocates and frees its own memory (create / destroy pairs). No ownership transfer across the boundary.&lt;br&gt;5. DLLs never link to each other; the engine wires them (mediator). Any module can be replaced, mocked or replayed.&lt;br&gt;6. ABI handshake at load (TC_ABI_VERSION): fail fast at start-up, never crash mid-session.&lt;br&gt;7. Errors are TcStatus codes; C++ exceptions are caught at the DLL edge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="730" height="250" as="geometry"/></mxCell><mxCell id="a_dp" value="&lt;b&gt;Performance&lt;/b&gt;&lt;br&gt;1. Hot path (MD &amp;gt; IND &amp;gt; STRAT &amp;gt; RISK) runs on one pipeline thread with direct function-table calls: no locks, no queues, no copies.&lt;br&gt;2. Lock-free SPSC rings only where threads must hand off; MPSC for the journal.&lt;br&gt;3. Header-only indicator core inlined into the strategy DLL; the indicator DLL export serves batch / research use.&lt;br&gt;4. Fixed-point int64 prices, pre-allocated pools, no heap allocation after start-up.&lt;br&gt;5. Batch APIs (arrays of events) to amortise boundary crossings.&lt;br&gt;6. Cache-line aligned ring indices (alignas(64)) to avoid false sharing.&lt;br&gt;7. Journal I/O on its own thread; it never blocks the trading path.&lt;br&gt;&lt;i&gt;Daily / swing horizon: latency is not critical, so determinism and testability come first.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="790" y="1670" width="730" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Runtime Workflow" id="w_dg"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="3400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="w_title" value="&lt;b&gt;Runtime Logic Workflow&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;market event to filled order (rule-based / technical indicators, IBKR execution)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1500" height="30" as="geometry"/></mxCell><mxCell id="w_legend" value="Rounded box = process | Diamond = decision | Pill = event / terminal | Solid arrow = direct call / event | Dashed arrow = async / feedback. Independent timer flow (T5) at the bottom of the Portfolio lane." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1000" y="5" width="1300" height="45" as="geometry"/></mxCell><mxCell id="w_lnGWI" value="&lt;b&gt;GATEWAY (in)&lt;/b&gt;&lt;br&gt;tc_gateway_ibkr.dll&lt;br&gt;Thread T1 (EReader)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnMD" value="&lt;b&gt;MARKET DATA&lt;/b&gt;&lt;br&gt;tc_marketdata.dll&lt;br&gt;Thread T2 (pipeline)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnIN" value="&lt;b&gt;INDICATORS&lt;/b&gt;&lt;br&gt;tc_indicators.dll (+ inline core)&lt;br&gt;Thread T2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4faf3;strokeColor=#82b366;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnST" value="&lt;b&gt;STRATEGY&lt;/b&gt;&lt;br&gt;tc_strategy.dll&lt;br&gt;Thread T2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f5fb;strokeColor=#9673a6;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnRK" value="&lt;b&gt;RISK&lt;/b&gt;&lt;br&gt;tc_risk.dll&lt;br&gt;T2 (state updates from T3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#b85450;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnEX" value="&lt;b&gt;EXECUTION&lt;/b&gt;&lt;br&gt;tc_execution.dll&lt;br&gt;Thread T3 (order thread)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbee;strokeColor=#d6b656;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="440" height="3160" as="geometry"/></mxCell><mxCell id="w_lnGWO" value="&lt;b&gt;GATEWAY (out)&lt;/b&gt;&lt;br&gt;tc_gateway_ibkr.dll&lt;br&gt;T3 calls / T1 callbacks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1540" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnPF" value="&lt;b&gt;PORTFOLIO&lt;/b&gt;&lt;br&gt;tc_portfolio.dll&lt;br&gt;T3 / T5 timer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eefafb;strokeColor=#0e8088;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1760" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lnJR" value="&lt;b&gt;JOURNAL&lt;/b&gt;&lt;br&gt;tc_journal.dll&lt;br&gt;Thread T4 (async writer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=1;verticalAlign=top;spacingTop=6;fontStyle=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1980" y="60" width="220" height="3160" as="geometry"/></mxCell><mxCell id="w_lx1" value="exception path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=10;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="180" height="18" as="geometry"/></mxCell><mxCell id="w_lx2" value="main path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontSize=11;spacingLeft=6;fontSize=10;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="130" width="180" height="18" as="geometry"/></mxCell><mxCell id="w_g1" value="Market-data event&lt;br&gt;(EWrapper: tickPrice / realtimeBar / historicalData)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="180" height="76" as="geometry"/></mxCell><mxCell id="w_gbf" value="Discard tick; mark feed DEGRADED;&lt;br&gt;request backfill (reqHistoricalData)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="355" width="180" height="70" as="geometry"/></mxCell><mxCell id="w_t1" value="Return to event loop&lt;br&gt;(wait for next event)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="578" width="180" height="64" as="geometry"/></mxCell><mxCell id="w_m1" value="Normalise raw callback &amp;gt;&lt;br&gt;TcTick / TcBar (POD, fixed-point price, ns timestamp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="242" width="180" height="76" as="geometry"/></mxCell><mxCell id="w_m2" value="Data valid?&lt;br&gt;(stale / gap / dup)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="340" width="200" height="100" as="geometry"/></mxCell><mxCell id="w_m3" value="Aggregate ticks &amp;gt; bars&lt;br&gt;(session calendar, timezone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="468" width="180" height="64" as="geometry"/></mxCell><mxCell id="w_m4" value="Bar closed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="560" width="200" height="100" as="geometry"/></mxCell><mxCell id="w_m5" value="Publish TcBarEvent&lt;br&gt;(direct call via function table)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="688" width="180" height="64" as="geometry"/></mxCell><mxCell id="w_t2" value="Accumulate history&lt;br&gt;(await warm-up bars)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="798" width="180" height="64" as="geometry"/></mxCell><mxCell id="w_i1" value="Update incremental indicators:&lt;br&gt;SMA, EMA, RSI, MACD, ATR, Bollinger, ADX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="682" width="180" height="76" as="geometry"/></mxCell><mxCell id="w_i2" value="Warm-up done?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="780" width="200" height="100" as="geometry"/></mxCell><mxCell id="w_i3" value="Fill TcIndicatorSnapshot&lt;br&gt;(per symbol, validity mask)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="908" width="180" height="64" as="geometry"/></mxCell><mxCell id="w_t3" value="End cycle&lt;br&gt;(no action)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="1348" width="180" height="64" as="geometry"/></mxCell><mxCell id="w_s1" value="Classify regime&lt;br&gt;(trend / range / high-vol via ADX, ATR percentile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="680" y="902" width="180" height="76" as="geometry"/></mxCell><mxCell id="w_s2" value="Evaluate EXIT rules on open positions (ATR trailing stop, target, reversal, time stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="680" y="1008" width="180" height="84" as="geometry"/></mxCell><mxCell id="w_s3" value="Entries allowed&lt;br&gt;by regime?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="670" y="1110" width="200" height="100" as="geometry"/></mxCell><mxCell id="w_s4" value="Evaluate ENTRY rules&lt;br&gt;(MA crossover + RSI + Bollinger / breakout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;st